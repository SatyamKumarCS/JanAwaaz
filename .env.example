# Local-only development settings (copy to .env; never commit .env).
# Neon URLs never go here: they live only in the git-ignored .env.neon (see .env.neon.example).
POSTGRES_USER=janawaaz
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=janawaaz
# Host port for the Compose db (default 5432). If 5432 is taken, set e.g. 5433 and use it in the URLs below.
DB_HOST_PORT=5432
DATABASE_URL=postgresql://janawaaz:change-me-local-only@localhost:5432/janawaaz
DIRECT_URL=postgresql://janawaaz:change-me-local-only@localhost:5432/janawaaz
API_PORT=4000
AI_MODE=stub
VISION_PROVIDER=mock
SEND_MODE=sandbox
PUSH_MODE=log
WHATSAPP_ENABLED=false
# Photo storage (I-12, D-19). Development only: STORAGE_DRIVER=local with an absolute PHOTO_STORAGE_DIR
# outside the repository and a random STORAGE_SIGNING_SECRET of at least 32 characters
# (e.g. `openssl rand -hex 32`). Empty STORAGE_DRIVER disables photo uploads.
# UPLOAD_CLAIM_SECRET (a different random value of at least 32 characters) signs citizen-bound upload claims.
# Optional: PHOTO_MAX_BYTES (512000, the shared maximum), PHOTO_UPLOAD_TTL_SECONDS (600), PHOTO_READ_TTL_SECONDS (900),
# UPLOAD_CLAIM_TTL_SECONDS (86400), STORAGE_PUBLIC_BASE_URL, RATE_LIMITS_UPLOAD_SIGN_PER_CREDENTIAL_MINUTE (120).
STORAGE_DRIVER=
PHOTO_STORAGE_DIR=
STORAGE_SIGNING_SECRET=
UPLOAD_CLAIM_SECRET=

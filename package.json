{
  "name": "janawaaz",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "lint": "eslint . && pnpm -r --if-present lint && pnpm lint:ai",
    "lint:ai": "uv run --directory services/ai ruff check . && uv run --directory services/ai ruff format --check .",
    "format": "prettier --write . && uv run --directory services/ai ruff format .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:ai",
    "test:ai": "uv run --directory services/ai pytest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:ignore": "git check-ignore .env .env.neon",
    "enums:export": "pnpm --filter @janawaaz/shared run export-enums",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "lefthook": "2.2.2"
  }
}

{
  "name": "@janawaaz/routing",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "node16",
            "moduleResolution": "node16",
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    }
  },
  "devDependencies": {
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "@types/jest": "30.0.0",
    "typescript": "6.0.3",
    "@types/node": "24.19.2"
  }
}
